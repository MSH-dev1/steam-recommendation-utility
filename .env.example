# Copy to .env and fill in. Never commit .env to git.

DEBUG=false

# Inside docker-compose host = db. Locally without a container = localhost.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/steamrec

# Added at step 2-3. Can be left empty at start.
STEAM_API_KEY=

# Used to build the Steam OpenID realm/return_to URLs.
BASE_URL=http://localhost:8000
